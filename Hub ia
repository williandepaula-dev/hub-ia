      <label class="label" style="color: #fda4af; font-weight: 700;">3. Seu @ do Instagram:</label>
      <input type="text" class="input" id="cfgIgUser" placeholder="@williandepaulatattoo">

      <label class="label">4. Contexto do Seu Negócio (para as IAs já saberem quem você é):</label>
      <textarea class="textarea" style="min-height: 64px;" id="cfgContext">Sou Willian, tatuador profissional especialista em realismo preto e cinza em Guarulhos - SP (@williandepaulatattoo) e desenvolvedor de software.</textarea>

      <button class="btn-full btn-ai" onclick="saveSettings()">💾 Salvar Tudo</button>
    </div>
  </div>

  <script>
    // INSTALAÇÃO PWA NO CELULAR
    let deferredPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      document.getElementById('installBanner').classList.add('show');
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      document.getElementById('installBanner').classList.remove('show');
      const sideBtn = document.getElementById('btnInstallSide');
      if (sideBtn) sideBtn.style.display = 'none';
    });

    async function installPWA() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          document.getElementById('installBanner').classList.remove('show');
        }
        deferredPrompt = null;
      } else {
        alert('Para criar o atalho de app no celular:\n\n1. Toque nos 3 pontinhos (⋮) no canto superior direito do Chrome.\n2. Toque em "Adicionar à tela inicial" ou "Instalar aplicativo".\n3. Confirme em "Instalar".');
      }
    }

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch(() => {});
      });
    }

    // CATÁLOGO DAS IAS MAIS COBIÇADAS PELOS DEVS
    const MODELS = [
      { id: 'google/gemini-3.8-flash', name: 'Gemini 3.8 Flash', provider: 'Google', icon: '✦', desc: 'Google • Rápido, visão e código', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'google/gemini-3.1-pro-preview', name: 'Gemini 3.1 Pro', provider: 'Google', icon: '✦', desc: 'Google • Raciocínio profundo 1M', tag: 'DEV #1', tagClass: 'tag-dev', cat: 'dev' },
      { id: 'anthropic/claude-fable-5.1', name: 'Claude Fable 5.1', provider: 'Anthropic', icon: 'A\\', desc: 'Anthropic • Arquitetura e agentes', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'anthropic/claude-opus-5.5', name: 'Claude Opus 5.5', provider: 'Anthropic', icon: 'A\\', desc: 'Anthropic • Elite em engenharia', tag: 'DEV #1', tagClass: 'tag-dev', cat: 'dev' },
      { id: 'anthropic/claude-sonnet-5.5', name: 'Claude Sonnet 5.5', provider: 'Anthropic', icon: 'A\\', desc: 'Anthropic • Velocidade + código', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'openai/gpt-6-astra', name: 'GPT-6 Astra', provider: 'OpenAI', icon: '◎', desc: 'OpenAI • Top Frontend & Lógica', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'openai/gpt-6.1-terra', name: 'GPT-6.1 Terra', provider: 'OpenAI', icon: '◎', desc: 'OpenAI • Multimodal 1M contexto', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'all' },
      { id: 'deepseek/deepseek-v4.1-flash-1017', name: 'DeepSeek V4.1 Flash', provider: 'DeepSeek', icon: '🐋', desc: 'DeepSeek • Mais usado em código', tag: 'DEV #1', tagClass: 'tag-dev', cat: 'dev' },
      { id: 'deepseek/deepseek-v4-pro-0813', name: 'DeepSeek V4 Pro', provider: 'DeepSeek', icon: '🐋', desc: 'DeepSeek • Raciocínio pesado', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'z-ai/glm-5.3', name: 'GLM-5.3', provider: 'Open', icon: '⌘', desc: 'Z.ai • Líder open-weights código', tag: 'DEV #1', tagClass: 'tag-dev', cat: 'dev' },
      { id: 'moonshotai/kimi-k3', name: 'Kimi K3', provider: 'Open', icon: '⌘', desc: 'Moonshot • Contexto longo & dev', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'dev' },
      { id: 'x-ai/grok-4.7', name: 'Grok 4.7', provider: 'xAI', icon: 'Ø', desc: 'xAI • Direto, sem rodeios', tag: 'FRONTEIRA', tagClass: 'tag-frontier', cat: 'all' },
      { id: 'qwen/qwen3.8-max', name: 'Qwen 3.8 Max', provider: 'Open', icon: '⌘', desc: 'Alibaba • Forte em full-stack', tag: 'DEV #1', tagClass: 'tag-dev', cat: 'dev' },
      { id: 'google/gemma-4-31b:free', name: 'Gemma 4 31B (Grátis)', provider: 'Google', icon: '✦', desc: 'OpenRouter • Custo zero', tag: 'GRÁTIS', tagClass: 'tag-free', cat: 'free' },
      { id: 'nvidia/nemotron-3-ultra:free', name: 'Nemotron 3 Ultra (Grátis)', provider: 'Open', icon: '⌘', desc: 'OpenRouter • Custo zero', tag: 'GRÁTIS', tagClass: 'tag-free', cat: 'free' },
      { id: 'openrouter/auto', name: 'OpenRouter Auto', provider: 'Open', icon: '⚡', desc: 'Escolhe a melhor IA sozinho', tag: 'AUTO', tagClass: 'tag-frontier', cat: 'all' }
    ];

    let selectedModel = MODELS[0];
    let currentTab = 'all';
    let currentProvider = 'all';
    let chatHistory = JSON.parse(localStorage.getItem('ai_hub_history') || '[]');

    // CONFIGURAÇÕES SALVAS
    const state = {
      openrouter: localStorage.getItem('hub_or_key') || '',
      gemini: localStorage.getItem('hub_gem_key') || '',
      groq: localStorage.getItem('groq_api_key') || localStorage.getItem('hub_groq_key') || '',
      waNumber: localStorage.getItem('hub_wa_num') || '',
      igUser: localStorage.getItem('hub_ig_user') || '@williandepaulatattoo',
      context: localStorage.getItem('hub_context') || 'Sou Willian, tatuador profissional especialista em realismo preto e cinza em Guarulhos - SP (@williandepaulatattoo) e desenvolvedor de software.'
    };

    function updateWaLinkDisplay() {
      const clean = state.waNumber.replace(/\D/g, '');
      const fullNum = clean.startsWith('55') ? clean : (clean ? '55' + clean : '5511999999999');
      const msg = encodeURIComponent('Olá Willian! Vim pelo seu Instagram e gostaria de fazer um orçamento de tattoo.');
      document.getElementById('myWaLinkBox').value = `https://wa.me/${fullNum}?text=${msg}`;
    }

    function openSettings() {
      document.getElementById('cfgOpenRouter').value = state.openrouter;
      document.getElementById('cfgGemini').value = state.gemini;
      document.getElementById('cfgGroq').value = state.groq;
      document.getElementById('cfgWaNumber').value = state.waNumber;
      document.getElementById('cfgIgUser').value = state.igUser;
      document.getElementById('cfgContext').value = state.context;
      document.getElementById('settingsModal').classList.add('open');
    }

    function closeSettings() {
      document.getElementById('settingsModal').classList.remove('open');
    }

    function saveSettings() {
      state.openrouter = document.getElementById('cfgOpenRouter').value.trim();
      state.gemini = document.getElementById('cfgGemini').value.trim();
      state.groq = document.getElementById('cfgGroq').value.trim();
      state.waNumber = document.getElementById('cfgWaNumber').value.trim();
      state.igUser = document.getElementById('cfgIgUser').value.trim() || '@williandepaulatattoo';
      state.context = document.getElementById('cfgContext').value.trim();

      localStorage.setItem('hub_or_key', state.openrouter);
      localStorage.setItem('hub_gem_key', state.gemini);
      localStorage.setItem('hub_groq_key', state.groq);
      if (state.groq) localStorage.setItem('groq_api_key', state.groq);
      localStorage.setItem('hub_wa_num', state.waNumber);
      localStorage.setItem('hub_ig_user', state.igUser);
      localStorage.setItem('hub_context', state.context);

      updateWaLinkDisplay();
      closeSettings();
    }

    // SIDEBAR & MODELOS
    function toggleSidebar(show) {
      document.getElementById('sidebar').classList.toggle('open', show);
      document.getElementById('overlay').classList.toggle('show', show);
    }

    function setTab(tab, el) {
      currentTab = tab;
      document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
      el.classList.add('active');
      renderModels();
    }

    function filterByProvider(prov, el) {
      currentProvider = prov;
      document.querySelectorAll('.rail-btn').forEach(b => b.classList.remove('active'));
      el.classList.add('active');
      renderModels();
    }

    function renderModels() {
      const q = document.getElementById('modelSearch').value.toLowerCase().trim();
      const list = document.getElementById('modelList');
      list.innerHTML = '';

      const filtered = MODELS.filter(m => {
        if (currentProvider !== 'all' && m.provider !== currentProvider) return false;
        if (currentTab === 'dev' && m.cat !== 'dev') return false;
        if (currentTab === 'free' && m.cat !== 'free') return false;
        if (q && !(m.name.toLowerCase().includes(q) || m.desc.toLowerCase().includes(q))) return false;
        return true;
      });

      filtered.forEach(m => {
        const btn = document.createElement('button');
        btn.className = 'model-item' + (m.id === selectedModel.id ? ' selected' : '');
        btn.innerHTML = `
          <div class="model-left">
            <div class="provider-badge">${m.icon}</div>
            <div class="model-info">
              <div class="model-name">${m.name}</div>
              <div class="model-desc">${m.desc}</div>
            </div>
          </div>
          <span class="tag ${m.tagClass}">${m.tag}</span>
        `;
        btn.onclick = () => {
          selectedModel = m;
          document.getElementById('topModelBadge').textContent = m.icon;
          document.getElementById('topModelName').textContent = m.name;
          renderModels();
          toggleSidebar(false);
        };
        list.appendChild(btn);
      });
    }

    function switchMode(mode) {
      document.querySelectorAll('.mode-btn').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.getElementById(`view-${mode}`).classList.add('active');
    }

    // MOTOR UNIFICADO DE CHAMADA IA
    async function callActiveAI(messages) {
      const sysPrompt = {
        role: 'system',
        content: `Contexto do usuário: ${state.context}. Responda em português do Brasil de forma direta, prática e profissional.`
      };
      const fullMessages = [sysPrompt, ...messages];

      if (state.openrouter) {
        const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${state.openrouter}`,
            'Content-Type': 'application/json',
            'HTTP-Referer': window.location.href,
            'X-Title': 'Willian AI Hub'
          },
          body: JSON.stringify({
            model: selectedModel.id,
            messages: fullMessages,
            temperature: 0.7
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error?.message || `Erro OpenRouter (${res.status})`);
        return data.choices[0].message.content;
      }

      if (state.gemini) {
        const userText = fullMessages.map(m => `${m.role.toUpperCase()}: ${m.content}`).join('\n\n');
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${state.gemini}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: userText }] }] })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error?.message || 'Erro na API Gemini');
        return data.candidates[0].content.parts[0].text;
      }

      if (state.groq) {
        const modelsRes = await fetch('https://api.groq.com/openai/v1/models', {
          headers: { 'Authorization': `Bearer ${state.groq}` }
        });
        const modelsData = await modelsRes.json();
        const textModels = (modelsData.data || []).map(m => m.id).filter(id => !/whisper|tts|guard|embed/i.test(id));
        const groqModel = textModels.find(id => /llama-4|llama-3\.3/i.test(id)) || textModels[0];

        const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${state.groq}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ model: groqModel, messages: fullMessages, temperature: 0.7 })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error?.message || 'Erro na API Groq');
        return data.choices[0].message.content;
      }

      openSettings();
      throw new Error('Cole sua chave da OpenRouter (ou Gemini/Groq) nas configurações para começar.');
    }

    function formatMarkdown(text) {
      const escaped = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      return escaped
        .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    }

    function renderChat() {
      const box = document.getElementById('chatMessages');
      box.innerHTML = '';

      if (chatHistory.length === 0) {
        box.innerHTML = `
          <div class="msg msg-ai">
            <div class="msg-meta"><span>⚡ HUB MULTI-IA PRONTO</span><span>CLAUDE • GEMINI • DEEPSEEK</span></div>
            <div class="msg-body">
              Escolha qualquer modelo no menu lateral (<strong>Claude, Gemini, GPT-6, DeepSeek, Grok</strong>) ou use as abas acima para criar posts do <strong>Instagram</strong> e respostas de <strong>WhatsApp</strong> com 1 toque.<br><br>
              Toque em <strong>📲 Instalar App na Tela Inicial</strong> no menu lateral para criar o atalho direto no celular.
            </div>
          </div>`;
        return;
      }

      chatHistory.forEach((m, idx) => {
        const div = document.createElement('div');
        div.className = 'msg ' + (m.role === 'user' ? 'msg-user' : 'msg-ai');
        if (m.role === 'user') {
          div.textContent = m.content;
        } else {
          div.innerHTML = `
            <div class="msg-meta"><span>${m.model || selectedModel.name}</span></div>
            <div class="msg-body">${formatMarkdown(m.content)}</div>
            <div class="msg-actions">
              <button class="act-btn" onclick="copyRaw(${idx})">📋 Copiar</button>
              <button class="act-btn act-btn-wa" onclick="pushToWa(${idx})">🟢 Mandar no WhatsApp</button>
              <button class="act-btn act-btn-ig" onclick="pushToIg(${idx})">📸 Levar p/ Instagram</button>
            </div>
          `;
        }
        box.appendChild(div);
      });
      box.scrollTop = box.scrollHeight;
    }

    window.copyRaw = (idx) => {
      navigator.clipboard.writeText(chatHistory[idx].content);
    };

    window.pushToWa = (idx) => {
      document.getElementById('waOutput').value = chatHistory[idx].content;
      switchMode('wa');
    };

    window.pushToIg = (idx) => {
      document.getElementById('igOutput').value = chatHistory[idx].content;
      switchMode('ig');
    };

    function clearChat() {
      chatHistory = [];
      localStorage.removeItem('ai_hub_history');
      renderChat();
      toggleSidebar(false);
    }

    function useQuickPrompt(prefix) {
      const inp = document.getElementById('chatInput');
      inp.value = prefix;
      inp.focus();
    }

    function handleChatKey(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendChatMessage();
      }
    }

    async function sendChatMessage() {
      const inp = document.getElementById('chatInput');
      const text = inp.value.trim();
      if (!text) return;

      inp.value = '';
      chatHistory.push({ role: 'user', content: text });
      renderChat();

      const btn = document.getElementById('btnSendChat');
      btn.disabled = true;

      try {
        const recent = chatHistory.slice(-10).map(m => ({ role: m.role, content: m.content }));
        const reply = await callActiveAI(recent);
        chatHistory.push({ role: 'assistant', content: reply, model: selectedModel.name });
        localStorage.setItem('ai_hub_history', JSON.stringify(chatHistory.slice(-30)));
      } catch (err) {
        chatHistory.push({ role: 'assistant', content: `⚠️ ${err.message}`, model: 'Sistema' });
      } finally {
        btn.disabled = false;
        renderChat();
      }
    }

    // ESTÚDIO INSTAGRAM
    async function generateInstagramPost() {
      const type = document.getElementById('igType').value;
      const topic = document.getElementById('igTopic').value.trim();
      const status = document.getElementById('igStatus');
      if (!topic) { status.textContent = '⚠️ Escreva ou fale sobre o que é a publicação.'; return; }

      const btn = document.getElementById('btnGenIg');
      btn.disabled = true;
      status.textContent = `⏳ Gerando com ${selectedModel.name}...`;

      try {
        const prompt = `Crie para o Instagram (${state.igUser}): ${type}.\nAssunto: ${topic}.\nEntregue apenas o texto pronto para copiar e colar no Instagram, sem explicações extras.`;
        const result = await callActiveAI([{ role: 'user', content: prompt }]);
        document.getElementById('igOutput').value = result.trim();
        status.textContent = '✅ Texto pronto! Toque em "Copiar e Abrir Instagram".';
      } catch (err) {
        status.textContent = `⚠️ ${err.message}`;
      } finally {
        btn.disabled = false;
      }
    }

    function openInstagramWithText() {
      const text = document.getElementById('igOutput').value.trim();
      if (text) navigator.clipboard.writeText(text);
      const user = state.igUser.replace('@', '').trim();
      const url = user ? `https://www.instagram.com/${user}/` : 'https://www.instagram.com/';
      document.getElementById('igStatus').textContent = '📋 Texto copiado! Abrindo Instagram...';
      window.open(url, '_blank');
    }

    // CENTRAL WHATSAPP
    function setWaPreset(preset) {
      document.getElementById('waPrompt').value = preset;
    }

    async function generateWhatsAppReply() {
      const prompt = document.getElementById('waPrompt').value.trim();
      const status = document.getElementById('waStatus');
      if (!prompt) { status.textContent = '⚠️ Digite ou cole a mensagem do cliente.'; return; }

      const btn = document.getElementById('btnGenWa');
      btn.disabled = true;
      status.textContent = `⏳ Criando resposta com ${selectedModel.name}...`;

      try {
        const fullPrompt = `Escreva uma mensagem direta, educada e persuasiva para enviar no WhatsApp.\nSituação: ${prompt}.\nEntregue SOMENTE o texto da mensagem pronto para enviar, sem aspas e sem introduções.`;
        const result = await callActiveAI([{ role: 'user', content: fullPrompt }]);
        document.getElementById('waOutput').value = result.trim();
        status.textContent = '✅ Resposta pronta! Toque em "Enviar no WhatsApp".';
      } catch (err) {
        status.textContent = `⚠️ ${err.message}`;
      } finally {
        btn.disabled = false;
      }
    }

    function sendToWhatsApp() {
      const msg = document.getElementById('waOutput').value.trim();
      if (!msg) {
        document.getElementById('waStatus').textContent = '⚠️ Gere ou escreva uma mensagem primeiro.';
        return;
      }
      const rawPhone = document.getElementById('waClientPhone').value.replace(/\D/g, '');
      const phone = rawPhone ? (rawPhone.startsWith('55') ? rawPhone : '55' + rawPhone) : '';
      const encoded = encodeURIComponent(msg);
      const url = phone ? `https://wa.me/${phone}?text=${encoded}` : `https://api.whatsapp.com/send?text=${encoded}`;
      window.open(url, '_blank');
    }

    function copyText(elId, statusId) {
      const val = document.getElementById(elId).value;
      if (!val) return;
      navigator.clipboard.writeText(val);
      document.getElementById(statusId).textContent = '📋 Copiado para a área de transferência!';
    }

    // DITADO POR VOZ NATIVO DO CELULAR
    function dictateTo(targetId, btn) {
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRec) {
        alert('Seu navegador não suporta ditado por voz.');
        return;
      }
      const rec = new SpeechRec();
      rec.lang = 'pt-BR';
      btn.textContent = '🔴';
      rec.onresult = (e) => {
        const transcript = e.results[0][0].transcript;
        const el = document.getElementById(targetId);
        el.value = el.value ? el.value + ' ' + transcript : transcript;
      };
      rec.onend = () => { btn.textContent = '🎙️'; };
      rec.start();
    }

    renderModels();
    renderChat();
    updateWaLinkDisplay();
  </script>
</body>
</html>
