  <!-- MODAL CONFIGURAÇÕES -->
  <div class="modal-backdrop" id="settingsModal">
    <div class="modal">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <h3 style="font-size: 15px;">⚙️ Configurar IAs e Redes</h3>
        <button class="icon-btn" style="width: 32px; height: 32px;" onclick="closeSettings()">✕</button>
      </div>

      <label class="label" style="color: #a5b4fc; font-weight: 700;">1. Chave OpenRouter (1 chave = Claude, Gemini, GPT-6, DeepSeek, Grok):</label>
      <input type="password" class="input" id="cfgOpenRouter" placeholder="sk-or-v1-...">

      <label class="label">Ou Chave Direta Google Gemini (opcional):</label>
      <input type="password" class="input" id="cfgGemini" placeholder="AIzaSy...">

      <label class="label">Ou Chave Direta Groq (opcional - ultra rápida):</label>
      <input type="password" class="input" id="cfgGroq" placeholder="gsk_...">

      <hr style="border: none; border-top: 1px solid var(--border); margin: 14px 0;">

      <label class="label" style="color: #4ade80; font-weight: 700;">2. Seu WhatsApp (com DDD, ex: 11999999999):</label>
